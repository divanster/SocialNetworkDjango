# Local-only overrides for running backend without Docker.
# Copy to ".env.local" and adjust as needed.

USE_SQLITE=True
DB_HOST=localhost
DB_PORT=5432

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002
CSRF_TRUSTED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002
CHANNELS_ALLOWED_HOSTS=localhost:3002,127.0.0.1:3002

REDIS_HOST=localhost
REDIS_PORT=6379
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=False
